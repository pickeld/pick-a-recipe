# Pick-a-Recipe — environment variables
# Copy to .env and fill in real values ( .env is gitignored ):
#   cp .env.example .env

# Flask session signing (required)
FLASK_SECRET_KEY=change-me-to-a-random-secret-key

# Server bind (optional)
HOST=0.0.0.0
PORT=5006
FLASK_DEBUG=false

# Job queue — parallel extractions (1–16, default 3)
MAX_CONCURRENT_JOBS=3

# Authentication mode: 'local' (default) or 'authentik'.
# 'local' needs no identity provider: the first visit lands on /setup to create
# the admin account, and that page closes for good once an account exists.
# AUTH_MODE=local
# Prefills the username field on the setup page; nothing more.
# AUTH_LOCAL_USERNAME=admin

# Authentik SSO (required when AUTH_MODE=authentik)
AUTHENTIK_ISSUER_URL=https://auth.pickel.me/application/o/pick-a-recipe
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Group membership gates access; admins additionally need AUTHENTIK_ADMIN_GROUP
AUTHENTIK_USER_GROUP=pick-a-recipe-users
AUTHENTIK_ADMIN_GROUP=admins

# Android app sign-in (JWT bearer tokens). Unset = mobile auth stays disabled.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=
# Custom URL schemes the app may receive tokens on (comma-separated)
# MOBILE_DEEP_LINK_SCHEMES=par

# Set to true when served over HTTPS (recommended in production)
SESSION_COOKIE_SECURE=false

# Public URL for OAuth callbacks when behind a reverse proxy (no trailing slash)
# PUBLIC_URL=https://recipes.pickel.me
