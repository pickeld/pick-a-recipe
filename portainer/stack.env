# Pick-a-Recipe — Portainer stack environment variables
# Copy to stack.env.local and fill in real values (gitignored):
#   cp portainer/stack.env portainer/stack.env.local
#
# Required for ./scripts/portainer-migrate.sh and ./scripts/portainer-deploy.sh

# App secret (required)
FLASK_SECRET_KEY=change-me-to-a-random-secret-key

# Job queue — parallel extractions (1–16, default 3)
MAX_CONCURRENT_JOBS=3

# Authentication mode: 'authentik' (default) or 'none' to disable sign-in
# entirely. Leave as authentik for anything reachable from the internet.
AUTH_MODE=authentik

# Authentik SSO (required for login unless AUTH_MODE=none)
AUTHENTIK_ISSUER_URL=https://auth.pickel.me/application/o/pick-a-recipe
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Group membership gates access; admins additionally need AUTHENTIK_ADMIN_GROUP
AUTHENTIK_USER_GROUP=pick-a-recipe-users
AUTHENTIK_ADMIN_GROUP=admins

# Android app sign-in (JWT bearer tokens). Leave empty to keep mobile auth off.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Set to true when served over HTTPS (recommended in production)
SESSION_COOKIE_SECURE=true

# Public URL for OIDC redirect URI derivation when behind a reverse proxy (no trailing slash)
PUBLIC_URL=https://recipes.pickel.me
# Allowed callback: https://recipes.pickel.me/auth/callback (registered in Authentik)

# Portainer API (required for full Portainer stack control)
# Use the same base URL you open in your browser.
# srv2/NAS: https://192.168.127.251:7441
PORTAINER_URL=
# Preferred: Portainer access token (My account → Access tokens)
PORTAINER_API_KEY=
# Optional fallback: username/password JWT auth
# PORTAINER_USER=admin
# PORTAINER_PASSWORD=
# Optional when PORTAINER_URL is an IP but TLS cert is for a hostname (NPM reverse proxy)
# PORTAINER_TLS_HOST=portainer.example.com

# Optional — auto-detected if unset
# PORTAINER_ENDPOINT_ID=1
